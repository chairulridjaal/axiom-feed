# Stockbit auth — watched for rotation (24h JWT, iat→exp 86400s)
# Copy fresh Bearer: DevTools → exodus.stockbit.com → Headers → Authorization: Bearer <token>
STOCKBIT_BEARER_TOKEN="eyJhbGciOiJSUzI1NiIsImtpZCI6..."
# Export all cookies as JSON array (DevTools → Application → Cookies → copy)
STOCKBIT_COOKIES_PATH="./cookies.json"
STOCKBIT_WS_URL="wss://wss-jkt.trading.stockbit.com/ws"
# Optional: AUTH_MODE=cookies (default) | browser (Playwright/curl_cffi fallback — feature-flag, no hard dep)
AUTH_MODE="cookies"

# Infra
REDIS_URL="redis://localhost:6379"
INGEST_MODE="redis"  # redis = consume via Redis Streams; direct = stream from ingest-rs via TCP loopback (zero-Redis); embedded = pure python WSS

# Direct IPC (zero-Redis single-node transport)
DIRECT_IPC_HOST="127.0.0.1"
DIRECT_IPC_PORT="8379"

# API
API_HOST="0.0.0.0"
API_PORT="8000"
API_KEY=""  # leave empty for dev (no auth), set to require X-API-Key on REST and ?token= on WS
CORS_ORIGINS="*"

# Historical slicing — bounded windows so no 60MB holds
CANDLES_SLICE_DAILY_DAYS="365"
CANDLES_SLICE_INTRADAY_DAYS="90"
CANDLES_CONCURRENCY="4"
CANDLES_CACHE_KEYS="100"
CANDLES_CACHE_BYTES="50000000"  # 50 MB

# Live bounds — drop-oldest counted
LIVE_MAX_SYMBOLS="200"
LIVE_QUEUE_PER_CLIENT="100"
LIVE_MAX_CLIENTS="500"

# Local tick store persistence & offline replay (SQLite WAL)
TICKS_DB_PATH="data/ticks.db"
TICKS_MAX_RECORDS="50000"
TICKS_BATCH_SIZE="50"
PARQUET_DIR="data/parquet"

# Subscription seed (for ingest-rs full-state resubscribe)
SUBSCRIBE_SYMBOLS="BBCA,TLKM,IHSG,BBRI,BMRI"
